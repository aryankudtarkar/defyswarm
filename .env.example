# GEMINI_API_KEY: Optional Google Gemini key (AI Studio runtime secret).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional Groq free-tier API key (no credit card required) for openai/gpt-oss-120b.
# Can also be configured at runtime via Onboarding or Setup -> Settings (stored in server memory only).
GROQ_API_KEY=""

# DEFYSWARM_INGEST_TOKEN: Optional fixed bearer/HMAC secret for S3/MinIO webhooks and external CLI uploads.
# If left empty, DefySwarm generates a cryptographically secure token in memory at boot.
DEFYSWARM_INGEST_TOKEN=""

# Optional external S3-compatible credentials (Backblaze B2 10 GB free, Supabase Storage S3 1 GB free, or MinIO).
# Can also be entered at runtime in Setup -> Settings (held in server memory only).
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_VAULT_ACCESS_KEY_ID=""
S3_VAULT_SECRET_ACCESS_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
